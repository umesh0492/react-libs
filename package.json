{
  "name": "@umesh0492/react-libs",
  "version": "0.6.0",
  "description": "React 19 component library with Tailwind CSS v4 & Radix UI primitives.",
  "keywords": [
    "react",
    "react19",
    "tailwind",
    "tailwindcss",
    "radix-ui",
    "components",
    "design-system",
    "ui-kit",
    "accessible",
    "storybook"
  ],
  "author": "Umesh Gupta <umesh0492@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umesh0492/react-libs.git"
  },
  "bugs": {
    "url": "https://github.com/umesh0492/react-libs/issues"
  },
  "homepage": "https://github.com/umesh0492/react-libs#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "utils": [
        "./dist/utils.d.ts"
      ],
      "analytics": [
        "./dist/analytics/index.d.ts"
      ],
      "analytics/react": [
        "./dist/analytics/react/index.d.ts"
      ],
      "hooks/use-toast": [
        "./dist/hooks/use-toast.d.ts"
      ],
      "pdf": [
        "./dist/pdf.d.ts"
      ],
      "india": [
        "./dist/india/index.d.ts"
      ],
      "india/react": [
        "./dist/india/react/index.d.ts"
      ],
      "button": [
        "./dist/button.d.ts"
      ],
      "dialog": [
        "./dist/dialog.d.ts"
      ],
      "card": [
        "./dist/card.d.ts"
      ],
      "badge": [
        "./dist/badge.d.ts"
      ],
      "input": [
        "./dist/input.d.ts"
      ]
    }
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "bundleDependencies": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/* 2.*",
    "src/styles"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsup && node scripts/build-css.mjs",
    "prepack": "node -e \"if (!fs.existsSync('dist/index.d.ts')) { const cp = require('child_process'); cp.execSync('npm run build', { stdio: 'inherit' }); }\"",
    "prepublishOnly": "npm run build",
    "test": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "perf": "node scripts/generate-performance-report.mjs",
    "check:types-pkg": "npx --yes @arethetypeswrong/cli --pack .",
    "check:directives": "node scripts/verify-directives.mjs && npm run check:ssr",
    "check:ssr": "vitest run src/__tests__/ssr-smoke.test.tsx",
    "check:size": "node scripts/check-bundle-size.mjs",
    "verify:release": "node scripts/verify-release-version.mjs",
    "extract:release-notes": "node scripts/extract-release-notes.mjs",
    "check:truth": "node scripts/docs-match-tree.mjs",
    "docs-match-tree": "node scripts/docs-match-tree.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "perf:open": "node scripts/generate-performance-report.mjs && open docs/performance-report.md"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./analytics": {
      "import": {
        "types": "./dist/analytics/index.d.ts",
        "default": "./dist/analytics/index.js"
      },
      "require": {
        "types": "./dist/analytics/index.d.cts",
        "default": "./dist/analytics/index.cjs"
      }
    },
    "./analytics/react": {
      "import": {
        "types": "./dist/analytics/react/index.d.ts",
        "default": "./dist/analytics/react/index.js"
      },
      "require": {
        "types": "./dist/analytics/react/index.d.cts",
        "default": "./dist/analytics/react/index.cjs"
      }
    },
    "./hooks/use-toast": {
      "import": {
        "types": "./dist/hooks/use-toast.d.ts",
        "default": "./dist/hooks/use-toast.js"
      },
      "require": {
        "types": "./dist/hooks/use-toast.d.cts",
        "default": "./dist/hooks/use-toast.cjs"
      }
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      }
    },
    "./india": {
      "import": {
        "types": "./dist/india/index.d.ts",
        "default": "./dist/india/index.js"
      },
      "require": {
        "types": "./dist/india/index.d.cts",
        "default": "./dist/india/index.cjs"
      }
    },
    "./india/react": {
      "import": {
        "types": "./dist/india/react/index.d.ts",
        "default": "./dist/india/react/index.js"
      },
      "require": {
        "types": "./dist/india/react/index.d.cts",
        "default": "./dist/india/react/index.cjs"
      }
    },
    "./button": {
      "import": {
        "types": "./dist/button.d.ts",
        "default": "./dist/button.js"
      },
      "require": {
        "types": "./dist/button.d.cts",
        "default": "./dist/button.cjs"
      }
    },
    "./dialog": {
      "import": {
        "types": "./dist/dialog.d.ts",
        "default": "./dist/dialog.js"
      },
      "require": {
        "types": "./dist/dialog.d.cts",
        "default": "./dist/dialog.cjs"
      }
    },
    "./card": {
      "import": {
        "types": "./dist/card.d.ts",
        "default": "./dist/card.js"
      },
      "require": {
        "types": "./dist/card.d.cts",
        "default": "./dist/card.cjs"
      }
    },
    "./badge": {
      "import": {
        "types": "./dist/badge.d.ts",
        "default": "./dist/badge.js"
      },
      "require": {
        "types": "./dist/badge.d.cts",
        "default": "./dist/badge.cjs"
      }
    },
    "./input": {
      "import": {
        "types": "./dist/input.d.ts",
        "default": "./dist/input.js"
      },
      "require": {
        "types": "./dist/input.d.cts",
        "default": "./dist/input.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "license": "MIT",
  "peerDependencies": {
    "jspdf": ">=2.5.0",
    "jspdf-autotable": ">=3.8.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-pdf": "^10.0.0",
    "xlsx": ">=0.18.0",
